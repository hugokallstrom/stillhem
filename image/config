# pi-gen config for the Stillhem image. Sourced by build-docker.sh.
IMG_NAME="stillhem"
RELEASE="bookworm"
DEPLOY_COMPRESSION="xz"
COMPRESSION_LEVEL="6"
TARGET_HOSTNAME="stillhem"

# --- Hardened defaults (this is what ships). ---
# The same .img goes to every buyer, so a baked-in password would be a
# credential shared across every device in the field. FIRST_USER_PASS is
# deliberately left UNSET, which makes pi-gen lock the account (no password
# login), and SSH is off. The appliance needs neither: it is administered
# entirely through the web UI, and the buyer sets their own admin password in
# the first-boot wizard.
#
# For local debugging, build with PIGEN_VARIANT=dev, which re-enables SSH and
# sets a known password. Never publish a dev image.
FIRST_USER_NAME="stillhem"
DISABLE_FIRST_BOOT_USER_RENAME="1"
ENABLE_SSH="0"

LOCALE_DEFAULT="en_US.UTF-8"
KEYBOARD_KEYMAP="se"
TIMEZONE_DEFAULT="Europe/Stockholm"
WPA_COUNTRY="SE"
